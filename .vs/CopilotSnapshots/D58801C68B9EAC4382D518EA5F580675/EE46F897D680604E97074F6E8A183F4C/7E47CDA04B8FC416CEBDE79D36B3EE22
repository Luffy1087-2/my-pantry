services:
  sqlserver:
    image: mcr.microsoft.com/mssql/server:2022-latest
    container_name: mypantry-sql
    environment:
      ACCEPT_EULA: "Y"
      MSSQL_SA_PASSWORD: "MyStrongPassword!123"
    ports:
      - "1433:1433"
    volumes:
      - sqlserver-data:/var/opt/mssql

  api:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: mypantry-api
    depends_on:
      - sqlserver
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ConnectionStrings__DefaultConnection: "Server=sqlserver,1433;Database=MyPantryDb;User Id=sa;Password=MyStrongPassword!123;TrustServerCertificate=True;"
    ports:
      - "8080:8080"

volumes:
  sqlserver-data:
